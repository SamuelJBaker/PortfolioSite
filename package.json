{
	"name": "samueljbaker",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"test": "vitest run",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"chess:review:book": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/chess-review/build-book.ts",
		"chess:review": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/chess-review/run.ts"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.3.0",
		"@react-three/drei": "^10.7.6",
		"@react-three/fiber": "^9.4.0",
		"chess.js": "^1.4.0",
		"framer-motion": "^12.23.24",
		"jose": "^6.2.17",
		"next": "^15.5.9",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"three": "0.180.0",
		"topojson-client": "^3.1.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-specification": "^1.0.5",
		"eslint": "^9.39.5",
		"eslint-config-next": "^15.5.29",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^3.2.7",
		"wrangler": "^4.43.0"
	},
	"overrides": {
		"stats-gl": "3.6.0"
	}
